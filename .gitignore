.ruff_cache/

# tooling
.specify/feature.json
node_modules/
*.log

# screenshot comparison outputs
tests/visual/output/

# Client documents are never committed. A prospect's files stay out of git until they are
# redacted and cleared, and even then they are dropped in locally, not pushed.
datasets/Northpointe - 1/
datasets/prospect-own/inputs/
datasets/opa-woodbend/inputs/
datasets/fyi-kerrisdale/inputs/
datasets/mobile-snap-sunridge/inputs/
!datasets/*/inputs/.gitkeep
