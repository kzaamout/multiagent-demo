# credentials
.env
.env.*
!.env.example

# run recordings (golden logs live under datasets/, not here). Anchored, so app/runs/ stays tracked.
/runs/

# client knowledge files written by live runs, seeded from datasets
/knowledge/

# Reading brought in from elsewhere: exports, vendor documentation, articles. Useful to have beside the
# code, not ours to publish, and never part of what a prospect is shown.
/research/

# python
.venv/
__pycache__/
*.pyc
.pytest_cache/
.mypy_cache/
.ruff_cache/

# tooling
.specify/feature.json
node_modules/
*.log

# screenshot comparison outputs
tests/visual/output/

# Datasets are not published by default. A prospect's files must never be committed, and even a
# synthetic set is released only when we decide to. To release one, add an allow line beside the
# README line below, for example:
#   !datasets/clean-run/
# Everything else under datasets/ stays local. Run recordings and knowledge files are ignored above.
datasets/*
!datasets/README.md
