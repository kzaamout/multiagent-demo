# Copy to .env and fill in, or run the setup script, which asks for each value with hidden input.
# .env is ignored by git. Never commit it and never paste its values into a chat or a ticket.

# Amazon Bedrock, used by the Orchestrator, Intake, Estimator, and Writer seats.
# Either access keys for a user or role with Bedrock access:
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
# Or a named profile from the AWS CLI configuration, instead of keys:
# AWS_PROFILE=

# Google Gemini, used by the Reviewer seat.
GEMINI_API_KEY=

# Optional. xAI Grok is listed in config/models.yaml but is not a default seat model.
# XAI_API_KEY=

# Per-run cost ceiling in US dollars, estimated from token counts. The run stops when the estimate passes it.
# COST_CEILING=1.00

# Optional. auto runs curated datasets live and the rest on stubs; stub runs every dataset on stubs.
# AGENT_MODE=auto
