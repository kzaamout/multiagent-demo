# Copy to .env and fill in, or run the setup script, which asks for each value with hidden input.
# .env is ignored by git. Never commit it and never paste its values into a chat or a ticket.

# Amazon Bedrock, used by the Orchestrator, Intake, Estimator, and Writer seats.
# Either access keys for a user or role with Bedrock access:
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
# Or a named profile from the AWS CLI configuration, instead of keys:
# AWS_PROFILE=

# Google Gemini, used by the Reviewer seat.
GEMINI_API_KEY=

# Optional. xAI Grok is listed in config/models.yaml but is not a default seat model.
# XAI_API_KEY=

# Hard ceiling on review cycles per run. Rework continues while a review cycle makes progress; this bounds it.
# REVIEW_MAX_CYCLES=4

# Per-run cost ceiling in US dollars, estimated from token counts. The run stops when the estimate passes it.
# COST_CEILING=1.00

# Optional. auto runs curated datasets live and the rest on stubs; stub runs every dataset on stubs.
# AGENT_MODE=auto

# The one recorded run the public Introduction replay serves. Any other run id is refused on the public routes.
# PUBLIC_RUN_ID=21b86b66-386a-4e3b-a351-8129e30cf456

# Shared login for the Demo, Settings, and Pre-flight pages (spec 2.8). Both must be set to enable it; the
# Introduction page stays public. The pair is compared in constant time. There are no accounts or resets.
# The pre-flight reports these as missing until they are set.
# DEMO_USERNAME=
# DEMO_PASSWORD=

# Run mode (spec 2.9). laptop: everything runs here, local models through Ollama, exposed through the tunnel.
# cloud: the app runs on a cloud host with cloud providers only, and local models are greyed in Settings.
# RUN_MODE=laptop

# Cloudflare Tunnel, Laptop mode on demo day. Create a remotely managed tunnel in the Cloudflare dashboard,
# route the public hostname to http://localhost:8000, and paste the tunnel token here. scripts/tunnel.ps1 and
# scripts/tunnel.sh start cloudflared with it. The pre-flight fetches the login page through the hostname.
# The hostname and the tunnel are still to be supplied by the owner (spec open item).
# TUNNEL_HOSTNAME=
# CLOUDFLARE_TUNNEL_TOKEN=
